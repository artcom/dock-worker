{
  "extends": ["artcom", "prettier"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["import", "typescript", "prettier"],
  "rules": {
    "typescript/no-unused-vars": "off",
    "no-unused-vars": "off",
    "no-console": "off",
    "no-use-before-define": "off",
    "prettier/prettier": "error",
    "space-before-function-paren": "off"
  },
  "settings": {
    "import/resolver": {
      "typescript": {}
    }
  }
}
