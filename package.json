{
  "name": "dock-worker",
  "version": "1.3.0",
  "description": "Automated Dokku Deployment",
  "repository": "artcom/dock-worker",
  "files": [
    "dist/"
  ],
  "bin": {
    "dock": "dist/main.js"
  },
  "scripts": {
    "prepublishOnly": "npm run test && npm run build",
    "debug": "npm run build && node --inspect-brk dist/main.js",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "start": "npm run build && node dist/main.js",
    "test": "npm run lint && mocha --import=tsx 'test/**/*.ts'",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "build": "rm -rf ./dist && tsc"
  },
  "dependencies": {
    "bl": "^7.0.12",
    "chalk": "^6.0.1",
    "docopt": "^0.6.2",
    "elegant-spinner": "^3.0.0",
    "lodash": "^4.18.1",
    "log-update": "^8.0.0",
    "read-promise": "^1.0.2",
    "ssh2": "^1.17.0",
    "strip-ansi": "^7.2.0",
    "text-table": "^0.2.0",
    "yn": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/docopt": "^0.6.37",
    "@types/lodash": "^4.17.26",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/sinon": "^22.0.0",
    "@types/ssh2": "^1.15.6",
    "@types/text-table": "^0.2.5",
    "@types/tmp": "^0.2.6",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "tmp": "^0.2.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "module"
}
